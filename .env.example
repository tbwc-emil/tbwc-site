DATABASE_URL=postgresql://postgres.detwkqhqekaiyuajixhs:YOUR-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Raw DB password (unencoded). Special chars (! # etc.) stay literal here,
# but must be URL-encoded inside DATABASE_URL above.
DB_PASSWORD=YOUR-PASSWORD

# Microsoft 365 SMTP (host smtp.office365.com:587 STARTTLS). Used by scripts/smtp-test.js.
# SMTP_PASS is an App Password, not the mailbox login password.
SMTP_USER=noreply@tbwcinc.com
SMTP_PASS=YOUR-APP-PASSWORD
SMTP_FROM=noreply@tbwcinc.com
