DATABASE_URL=postgresql://postgres.ihnezwvduwimprqascsf:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Raw DB password (unencoded). Special chars (! # etc.) stay literal here,
# but must be URL-encoded inside DATABASE_URL above.
DB_PASSWORD=YOUR-PASSWORD

# Brevo transactional email. The edge functions read BREVO_API_KEY from Supabase
# secrets, not from this file; these are here for local scripts only.
# BREVO_API_KEY must be an API v3 key (xkeysib-...), NOT an SMTP key (xsmtpsib-...).
BREVO_API_KEY=xkeysib-YOUR-API-V3-KEY
MAIL_FROM_EMAIL=noreply@tbwcinc.com
MAIL_FROM_NAME=TBWC Technology
